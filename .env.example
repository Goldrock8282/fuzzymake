# Anthropic API key — used by Claude for prompt enhancement
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — used by DALL-E 3 for image generation
OPENAI_API_KEY=sk-...

# Optional: DALL-E image size (1024x1024, 1024x1792, 1792x1024)
DALLE_SIZE=1024x1024

# Optional: DALL-E quality (standard or hd)
DALLE_QUALITY=standard

# Optional: Flask port
PORT=5000
